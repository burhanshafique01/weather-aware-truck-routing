# Copy to .env (or set in your host's dashboard). Every value is optional for local development.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Providers (all keyless by default)
VALHALLA_URL=https://valhalla1.openstreetmap.de
VALHALLA_MAX_LEG_KM=1500
PHOTON_URL=https://photon.komoot.io
OPEN_METEO_URL=https://api.open-meteo.com
# Set for Open-Meteo's commercial API (higher limits)
OPEN_METEO_API_KEY=

WEATHER_CACHE_SECONDS=1800
API_RATE_LIMIT=30/min

# Frontend (build time)
# VITE_API_BASE=https://your-api.example.com
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
